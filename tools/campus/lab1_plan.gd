## Lab 1 — Research. 80 x 64 m, building-local metres (north = -Z).
## Skeleton shared by every floor: 10 m outer room bands, a 3 m ring corridor,
## inner blocks around a 16 x 16 m atrium with a 2.5 m gallery, E-W cross
## corridors at z 0 and a N-S cross corridor at x -4 aligned with the skybridge.
## Core A (stair, two lifts) is north-west; core B (stair to roof, freight lift)
## is south-east. Doors: "side:position[:kind[:width]]".

static func R(title: String, x0: float, z0: float, x1: float, z1: float, role: String, doors: Array, extra := {}) -> Dictionary:
	var result := {"name": title, "rect": Rect2(x0, z0, x1 - x0, z1 - z0), "role": role, "doors": doors}
	result.merge(extra)
	return result

