extends SceneTree

## Review artifacts come from editor-owned scenes, never from a second layout recipe.
func _initialize() -> void: call_deferred("run")
func escape(value: String) -> String: return value.xml_escape()
func run() -> void:
	var scene: Node3D=load("res://scenes/raid/district/district_19381.tscn").instantiate()
	var author:=DistrictSceneAuthor.new(); author.scene=scene
	var audit: Array[Dictionary]=[]
	var markdown:=" autogenerated"
	markdown="# Static MedTac campus area audit\n\nThe four building scenes are the architecture source. This table and the labelled floor plans are derived from their actual nodes. Capture filenames are indexed in `.godot/campus-review/capture-index.json`.\n\n| Area | Purpose / functions | Entrances | Equipment | Loot furnishings / sockets | Service access |\n|---|---|---|---|---|---|\n"
	DirAccess.make_dir_recursive_absolute("res://docs/campus-floorplans")
	for building in scene.get_node("NavigationRegion3D").get_children():
		if not building.has_meta("enterable"): continue
		var bounds: AABB=building.get_meta("building_bounds")
		for floor_node in building.get_children():
			if not floor_node.has_meta("floor_id"): continue
			var svg:="<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 1100\"><rect width=\"1200\" height=\"1100\" fill=\"#142523\"/><style>text{font:14px sans-serif;fill:#ecf2e6}.room{fill:#28453d;stroke:#93aa87;stroke-width:1.5}</style>"
			svg+="<text x=\"30\" y=\"35\">%s / %s — north is up; dimensions in meters</text>"%[escape(str(building.name)),escape(str(floor_node.name))]
			var scale:=minf(1080/bounds.size.x,930/bounds.size.z)
			var origin:=Vector2(60,90)-Vector2(bounds.position.x,bounds.position.z)*scale
			var floor_rooms:=CampusValidator.rooms(floor_node)
			for room in floor_rooms:
				var b: AABB=room.transform*room.get_meta("room_bounds")
				var a:=origin+Vector2(b.position.x,b.position.z)*scale
				var size:=Vector2(b.size.x,b.size.z)*scale
				var title: String=room.get_meta("room_purpose")
				svg+="<rect class=\"room\" x=\"%f\" y=\"%f\" width=\"%f\" height=\"%f\"/><text x=\"%f\" y=\"%f\">%s</text><text x=\"%f\" y=\"%f\">%.1f × %.1f</text>"%[a.x,a.y,size.x,size.y,a.x+5,a.y+18,escape(title),a.x+5,a.y+36,b.size.x,b.size.z]
				var entrances: Array=[]
				for point: Vector3 in room.get_meta("entrance_points"):
					var p: Vector3=room.transform*point; var at:=origin+Vector2(p.x,p.z)*scale
					svg+="<circle cx=\"%f\" cy=\"%f\" r=\"5\" fill=\"#f1c467\"/>"%[at.x,at.y]
					entrances.append([p.x,p.y,p.z])
				var equipment: Array=[]; var containers: Array=[]; var loose:=0
				for prop in room.get_children():
					if prop.has_meta("campus_equipment"): equipment.append(prop.get_meta("campus_equipment"))
					if prop is SearchableFurniture: containers.append({"id":prop.entity_id,"model":prop.display_name,"profile":prop.loot_profile,"keycard_candidate":prop.keycard_candidate,"guarantees":prop.guaranteed_items})
					if prop is RaidLootPickup: loose+=1
				var at: Vector3=author.world_transform(room).origin
				var data:={"name":title,"building":building.get_meta("building_id"),"floor":str(floor_node.name),"at":[at.x,at.y,at.z],"purpose":room.get_meta("room_role"),"functions":room.get_meta("functions",[title]),"entrances":entrances,"equipment":equipment,"loot":{"searchable":containers.size(),"loose_sockets":loose,"containers":containers},"service_access":room.get_meta("service_access"),"encounter":"departmental movement and optional search","corrected":"purpose-sized editable floor plan; shared walls; physical clearance checks"}
				audit.append(data)
				markdown+="| %s / %s | %s | %d | %s | %d / %d | %s |\n"%[building.get_meta("building_id"),title,", ".join(data.functions),entrances.size(),", ".join(equipment),containers.size(),loose,data.service_access]
			for marker in floor_node.find_children("*","Marker3D",true,false):
				if not marker.has_meta("route_points"): continue
				var points:=""
				for p: Vector3 in marker.get_meta("route_points"):
					var at:=origin+Vector2(p.x,p.z)*scale; points+="%f,%f "%[at.x,at.y]
				svg+="<polyline points=\"%s\" fill=\"none\" stroke=\"#f1c467\" stroke-width=\"3\"/>"%points
			svg+="<text x=\"30\" y=\"1065\">Gold: entrances and circulation. Physical geometry and navigation are checked separately.</text></svg>"
			var name:=str(building.get_meta("building_id"))+"_"+str(floor_node.name).to_snake_case()
			var file:=FileAccess.open("res://docs/campus-floorplans/"+name+".svg",FileAccess.WRITE); file.store_string(svg)
	for area: Dictionary in scene.get_meta("campus_audit"):
		if not area.has("building"):
			audit.append(area)
			markdown+="| %s | %s | %s | %s | — | %s |\n"%[area.name,area.purpose,area.entrances,area.equipment,area.service_access]
	var file:=FileAccess.open("res://resources/district/reports/campus-area-audit.json",FileAccess.WRITE); file.store_string(JSON.stringify(audit,"\t")); file.close()
	file=FileAccess.open("res://docs/campus-area-audit.md",FileAccess.WRITE); file.store_string(markdown); file.close()
	print("CAMPUS FLOOR PLANS / AUDIT: ",audit.size()," areas")
	scene.free(); quit()
