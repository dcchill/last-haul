extends SceneTree

var checks:=0
var failures:=0

func _initialize() -> void: call_deferred("run")

func check(ok: bool,label: String) -> void:
	checks+=1
	if not ok: failures+=1; push_error("FAIL: "+label)

func run() -> void:
	var identity:="import_probe_"+str(Time.get_ticks_usec())
	var source_path:="res://.godot/"+identity+".glb"
	var destination:="res://scenes/props/district/"+identity+".tscn"
	var definition_path:="res://resources/district/assets/"+identity+".tres"
	var source:=Node3D.new(); source.name="ArtistFixture"
	var group:=Node3D.new(); group.name="NestedTransform"; group.rotation.y=.5; group.position=Vector3(1,0,2)
	source.add_child(group); group.owner=source
	var visual:=MeshInstance3D.new(); visual.name="MachineHousing"
	var mesh:=BoxMesh.new(); mesh.size=Vector3(1,2,1); mesh.material=StandardMaterial3D.new()
	visual.mesh=mesh; visual.position=Vector3(2,1,3); group.add_child(visual); visual.owner=source
	var document:=GLTFDocument.new(); var state:=GLTFState.new()
	check(document.append_from_scene(source,state)==OK and document.write_to_filesystem(state,source_path)==OK,"GLB fixture exports")
	source.free()
	var output: Array=[]
	var arguments:=PackedStringArray(["--headless","--path",ProjectSettings.globalize_path("res://"),"--script","res://tools/import_district_asset.gd","--",source_path,identity])
	var code:=OS.execute(OS.get_executable_path(),arguments,output,true)
	check(code==0 and not str(output).contains("SCRIPT ERROR"),"native GLB import and wrapper succeeds: "+str(output) if code!=0 else "native GLB import and wrapper succeeds")
	if code==0 and FileAccess.file_exists(destination):
		var asset: Node3D=load(destination).instantiate(); root.add_child(asset)
		var definition:=load(definition_path) as WorldAssetDefinition
		var report:=WorldAssetValidator.inspect(asset,definition)
		check(report.errors.is_empty(),"imported bounds/materials/collision survive wrapper packing: "+str(report.errors))
		var bounds: AABB=asset.get_meta("bounds")
		check(absf(bounds.position.y)<.001 and absf(bounds.get_center().x)<.001 and absf(bounds.get_center().z)<.001,"nested source is grounded and centered")
		for frame in 3: await physics_frame
		var ray:=PhysicsRayQueryParameters3D.create(Vector3(-5,1,0),Vector3(5,1,0),1)
		check(not root.world_3d.direct_space_state.intersect_ray(ray).is_empty(),"imported physical collision occupies normalized mesh")
		var before:=FileAccess.get_sha256(destination)
		output.clear()
		check(OS.execute(OS.get_executable_path(),arguments,output,true)!=0 and FileAccess.get_sha256(destination)==before,"reimport refuses to overwrite an existing authored asset")
		asset.free()
	# These three paths are uniquely generated by this test; no source art is removed.
	for path in [source_path,destination,definition_path]:
		if FileAccess.file_exists(path): DirAccess.remove_absolute(path)
	print("DISTRICT IMPORT: %d checks, %d failures"%[checks,failures])
	quit(1 if failures else 0)
